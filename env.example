# Copy to .env and fill in. Never commit .env.

# Neon: runtime + tests use the non-owner app role (RLS applies to it).
# Pooled endpoint (host contains "-pooler") is fine here; tenant is set per transaction.
DATABASE_URL=postgresql+psycopg://resolvedesk_app:<password>@<pooler-host>/neondb?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://resolvedesk_app:<password>@<pooler-host>/resolvedesk_test?sslmode=require
# Migrations + LangGraph checkpointer: owner role, DIRECT (unpooled) endpoint = host without "-pooler".
MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<direct-host>/neondb?sslmode=require
# Dev reseed / test cleanup role (NOBYPASSRLS): may delete engine rows, RLS still applies.
MAINT_DATABASE_URL=postgresql+psycopg://resolvedesk_maint:<password>@<pooler-host>/neondb?sslmode=require
TEST_MAINT_DATABASE_URL=postgresql+psycopg://resolvedesk_maint:<password>@<pooler-host>/resolvedesk_test?sslmode=require
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<direct-host>/resolvedesk_test?sslmode=require

# LLMs
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_CLASSIFIER_PROVIDER=groq
LLM_FALLBACK_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
LLM_CACHE=1
# Optional overrides (defaults in app/config.py): model per role and provider, limits.
# LLM_MAIN_MODEL_GEMINI=gemini-2.5-flash
# LLM_CLASSIFIER_MODEL_GEMINI=gemini-2.5-flash-lite
# LLM_MAIN_MODEL_GROQ=llama-3.3-70b-versatile
# LLM_CLASSIFIER_MODEL_GROQ=llama-3.1-8b-instant
# LLM_OLLAMA_MODEL=qwen2.5:3b
# LLM_MAX_CALLS_PER_RUN=8
# LLM_RETRY_ATTEMPTS=3

# Auth. APP_ENV defaults to prod, which refuses DEMO_AUTH=true and the default JWT secret.
APP_ENV=dev
DEMO_AUTH=true
# At least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
