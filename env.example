# Copy to .env and fill in. Never commit .env.

# Neon: runtime + tests use the non-owner app role (RLS applies to it).
# Pooled endpoint (host contains "-pooler") is fine here; tenant is set per transaction.
DATABASE_URL=postgresql+psycopg://resolvedesk_app:<password>@<main-branch-pooler-host>/neondb?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://resolvedesk_app:<password>@<test-branch-pooler-host>/neondb?sslmode=require
# Migrations + LangGraph checkpointer: owner role, DIRECT (unpooled) endpoint.
MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<main-branch-direct-host>/neondb?sslmode=require
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<test-branch-direct-host>/neondb?sslmode=require

# LLMs
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_CLASSIFIER_PROVIDER=groq
LLM_FALLBACK_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
LLM_CACHE=1

# Auth
JWT_SECRET=dev-only-change-me
